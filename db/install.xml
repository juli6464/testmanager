<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/testmanager/db" VERSION="2026090804" COMMENT="XMLDB file for Test Manager plugin">
  <TABLES>
    <TABLE NAME="local_testmanager_courses" COMMENT="Cursos independientes">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="moodlecourseid" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
    </TABLE>

    <TABLE NAME="local_testmanager_categories" COMMENT="Categorias dentro de cada curso">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="is_trash" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_course" TYPE="foreign" FIELDS="courseid" REFTABLE="local_testmanager_courses" REFFIELDS="id"/>
      </KEYS>
    </TABLE>

    <TABLE NAME="local_testmanager_tests" COMMENT="Tests alojados en categorias">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="categoryid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="origcategoryid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Categoria de origen cuando el test esta en la papelera"/>
        <FIELD NAME="quizid" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="question_count" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="masterid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Id del test maestro del que este es copia (0/igual a id = es su propio maestro)"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Ultima vez que cambio el numero de preguntas del cuestionario"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_category" TYPE="foreign" FIELDS="categoryid" REFTABLE="local_testmanager_categories" REFFIELDS="id"/>
      </KEYS>
    </TABLE>

    <TABLE NAME="local_testmanager_test_links" COMMENT="Cuestionarios (cmid) donde se importaron las preguntas de un test maestro, para sincronizar altas/bajas">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="masterid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="local_testmanager_tests.id del test maestro"/>
        <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="course_module id del cuestionario destino donde se importaron las preguntas"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="masterid" UNIQUE="false" FIELDS="masterid"/>
        <INDEX NAME="masterid-cmid" UNIQUE="true" FIELDS="masterid, cmid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>